NODE_ENV=development
PORT=3000

# Firestore MongoDB API — replace <username> and <password> with your credentials.
# URL-encode special characters in the password (@, #, :, /, etc.).
MONGODB_URI=mongodb://<username>:<password>@9d27564f-0b11-41a1-a918-20096fd11bf4.southamerica-east1.firestore.goog:443/salsa?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false

# Auth — use a long random string for JWT_SECRET (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRES_IN=7d

# Apple Sign In — Bundle ID do app iOS (ex: com.yourcompany.salsa)
APPLE_CLIENT_ID=com.yourcompany.salsa
